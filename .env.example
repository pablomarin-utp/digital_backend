# Supabase/Postgres connection string (replace placeholders)
SUPABASE_DB_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Supabase service role key (keep secret, used only server-side)
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>

# Optional JWT secret (for future work / separate branch)
SUPABASE_JWT_SECRET=
