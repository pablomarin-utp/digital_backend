# Copia este archivo como .env y rellena los valores

# "local" usa pickle+disco (default), "supabase" usa pgvector
FACE_STORE=local

# Solo necesario cuando FACE_STORE=supabase
# Los encuentras en Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJ...   # usa la service_role key (no la anon)
